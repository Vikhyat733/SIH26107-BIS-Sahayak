  "sti_rules": {
    "sampling_lot_size_tonnes": 40,
    "ladle_analysis_frequency": "1 test per heat/cast",
    "product_analysis_frequency": "1 test per 40 tonnes or part thereof for each size",
    "tensile_test_frequency": "1 test per 40 tonnes or part thereof for each size",
    "bend_rebend_frequency": "1 test per 40 tonnes or part thereof for each size",
    "mass_variation_frequency": "1 test per 10 tonnes or part thereof",
    "surface_rib_geometry_frequency": "1 test per 8-hour shift per size",
    "retun_retest_rule": "If any sample fails, two further samples from the same lot shall be tested. If both pass, lot passes; if either fails, lot is rejected."
  },
  "required_lab_equipment": [
    { "name": "Optical Emission Spectrometer (OES) / Chemical Wet Lab", "purpose": "Chemical Ladle & Product Analysis (C, S, P, Mn, Si, Cr, Mo, V, Ni, Cu)", "calibration_interval_months": 6 },
    { "name": "Universal Testing Machine (UTM) - Minimum 600 kN / 1000 kN capacity", "purpose": "0.2% Proof Stress, Tensile Strength, Total Elongation (IS 1608)", "calibration_interval_months": 12 },
    { "name": "Mandrel Bend & Rebend Testing Rig", "purpose": "180 deg Cold Bend and 135/157.5 deg Reverse Bend testing (IS 1599)", "calibration_interval_months": 12 },
    { "name": "Digital Micro-balance & Length Measuring Scale", "purpose": "Nominal mass per metre variation (IS 1786 Cl 6.2)", "calibration_interval_months": 6 },
