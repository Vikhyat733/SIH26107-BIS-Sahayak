{
  "standard_code": "IS 1786:2008",
  "title": "High Strength Deformed Steel Bars and Wires for Concrete Reinforcement — Specification (Fourth Revision)",
  "source": "Bureau of Indian Standards",
  "source_url": "https://www.bis.gov.in/",
  "document_type": "standard",
  "verification_status": "authoritative",
  "evidence": [
    {
      "text": "This standard covers the requirements of deformed steel bars and wires for use as reinforcement in concrete, in the following strength grades: a) Fe 415, Fe 415D; b) Fe 500, Fe 500D; c) Fe 550, Fe 550D; and d) Fe 600.",
      "section": "1.1 Scope",
      "source_url": "https://www.bis.gov.in/"
    }
  ],
  "category": "Civil & Metallurgical Engineering",
  "sti_reference": "STI/1786/7 (Scheme of Testing and Inspection)",
  "formulae": {
    "carbon_equivalent": {
      "expression": "C + (Mn / 6) + ((Cr + Mo + V) / 5) + ((Ni + Cu) / 15)",
      "clause": "Table 1, Note 1",
      "description": "Carbon equivalent formula evaluated when carbon content exceeds 0.12%"
    },
    "ts_ys_ratio": {
      "expression": "tensile_strength / yield_stress",
      "clause": "Table 3",
      "description": "Ratio of Ultimate Tensile Strength to 0.2% Proof Stress / Yield Stress"
    }
  },
